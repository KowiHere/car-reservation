# Skopiuj do .env (plik .env jest zignorowany przez git) i ewentualnie zmień wartości.
# Domyślne wartości poniżej odpowiadają docker-compose.yml (lokalny Postgres na dysku).

DB_URL=jdbc:postgresql://localhost:5432/warsztat
DB_USERNAME=warsztat
DB_PASSWORD=warsztat_local_dev

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
